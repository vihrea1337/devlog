<?xml version="1.0" encoding="utf-8"?>
<!-- Мержится только в debug-сборку поверх основного манифеста: добавляет
     networkSecurityConfig, чтобы приложение могло ходить по обычному HTTP
     на локальный сервер при тестировании. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
