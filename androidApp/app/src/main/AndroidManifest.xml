<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Приложение ходит в интернет (к нашему бэкенду) — нужно это разрешение. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WorkManager проверяет условие «есть сеть» перед синхронизацией. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+: вечернее напоминание — уведомление; разрешение спрашиваем,
         когда пользователь сам включает напоминание в профиле. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- allowBackup=false + dataExtractionRules: JWT-токен и кэш не уезжают
         в облачную резервную копию (см. xml/data_extraction_rules.xml). -->
    <application
        android:name=".DevLogApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevLog">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.DevLog.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager по умолчанию создаёт себя сам при старте. Отключаем это:
             его настраивает DevLogApp — с фабрикой воркеров от Hilt, иначе воркеры
             с зависимостями в конструкторе не создадутся. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
