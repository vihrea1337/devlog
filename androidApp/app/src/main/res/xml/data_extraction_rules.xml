<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: что можно уносить в облачную копию и при переносе на новый телефон.
     Ничего: там JWT-токен и кэш записей. Токен в чужом облаке — лишний риск, а записи
     и так лежат на сервере и скачаются после входа. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
