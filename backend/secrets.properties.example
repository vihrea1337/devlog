# Образец локальных секретов бэкенда DevLog.
# СКОПИРУЙ этот файл рядом как secrets.properties и впиши значения.
# secrets.properties в git НЕ попадает (см. .gitignore). Ключи в чат не присылай.

# Ключ Groq для ИИ-обработки записей (console.groq.com -> API Keys).
# Без ключа записи просто остаются в статусе 'queued' (приложение работает).
groq.api.key=

# (необязательно) Модель Groq. По умолчанию openai/gpt-oss-20b.
# groq.model=openai/gpt-oss-20b

# (необязательно, задаём позже) Секрет для подписи JWT в проде.
# jwt.secret=
