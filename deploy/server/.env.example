# Скопируй в .env и заполни. Файл .env в git НЕ коммитится.
#   cp .env.example .env && nano .env
#
# Здесь лежат значения, которые docker-compose подставляет в конфиг (${...}).

# Пароль базы (любой надёжный; используется контейнером Postgres И бэкендом — держим одинаковым).
DB_PASSWORD=придумай_надёжный_пароль

# Токен DuckDNS — со страницы https://www.duckdns.org (строка "token" вверху).
# Им Caddy подтверждает владение доменом и получает HTTPS-сертификат. Один токен на весь аккаунт.
DUCKDNS_TOKEN=твой_duckdns_token

# --- Адрес, по которому DevLog будет доступен снаружи ---
# Отдельный DuckDNS-домен под DevLog (заводится за минуту на duckdns.org; тот же
# DUCKDNS_TOKEN подойдёт). ВАЖНО: на странице DuckDNS у этого домена надо указать IP
# ТОГО сервера, куда деплоишь, иначе сертификат выпустится, но снаружи никто не достучится.
# Домен пишем ТОЛЬКО латиницей: кириллица превращается в punycode (xn--...), и Caddy
# не выпустит сертификат.
DEVLOG_DOMAIN=devlog-придумай-имя.duckdns.org
# Порт из диапазона 34000–35000. Проверь, что он свободен: ss -tlnp | grep 34444
DEVLOG_PORT=34444
