# Caddy терминирует HTTPS на порту DEVLOG_PORT и проксирует запросы в наш Ktor-бэкенд.
# Сертификат выпускается автоматически через DNS-проверку DuckDNS (порты 80/443 НЕ нужны —
# их на сервере занимает чужой стек). Домен и порт подставляются из .env через {$ПЕРЕМЕННАЯ}.
{$DEVLOG_DOMAIN}:{$DEVLOG_PORT} {
	tls {
		dns duckdns {env.DUCKDNS_TOKEN}
		resolvers 1.1.1.1
	}

	# Сборки Android-приложения — файлы из папки ./downloads на сервере (монтируется в
	# /srv/download, см. docker-compose.yml). В образ бэкенда APK не кладём: новую сборку
	# можно выложить без пересборки сервера. Ссылка на странице install.html —
	# /download/DevLog.apk (имя постоянное).
	handle /download/* {
		root * /srv
		# Тип файла явно: иначе браузер на Android может сохранить APK как «.bin».
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header Cache-Control "no-cache"
		file_server
	}

	# Всё остальное — бэкенд (веб-приложение, API, публичные отчёты).
	handle {
		reverse_proxy devlog-backend:8080
	}
}
