# Скопируй в devlog.env и заполни. Файл devlog.env в git НЕ коммитится.
#   cp devlog.env.example devlog.env && nano devlog.env
#
# Это СЕКРЕТЫ бэкенда — они прокидываются внутрь контейнера devlog-backend (env_file).

# Ключ Groq для ИИ-обработки записей. Тот же, что используешь локально в
# backend/secrets.properties (groq.api.key). Без него сервер работает, но ИИ "спит".
GROQ_API_KEY=твой_groq_api_key

# Секрет для подписи JWT-токенов. В проде ОБЯЗАТЕЛЬНО свой, длинный и случайный
# (например: openssl rand -hex 32). Если сменить позже — все выданные токены станут
# недействительны (пользователям надо будет войти заново).
JWT_SECRET=сгенерируй_длинную_случайную_строку

# --- Необязательное (можно не задавать — возьмутся значения по умолчанию) ---
# Модель Groq для разбора записей (по умолчанию openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b
# Модель для отчётов (по умолчанию openai/gpt-oss-120b; недоступна — откат на GROQ_MODEL, затем на gpt-oss-20b).
# GROQ_REPORT_MODEL=openai/gpt-oss-120b
# Share-токен отчёта, который показывает /demo (часть ссылки после /r/). Не задан — /demo ведёт на /install.html.
# DEMO_REPORT_TOKEN=
# Суточный лимит обращений к ИИ на одного пользователя (по умолчанию 200).
# AI_DAILY_LIMIT=200
